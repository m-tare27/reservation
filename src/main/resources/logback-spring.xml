<configuration>

    <!-- ===== Common Pattern ===== -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger - %msg%n"/>

    <!-- ===== PAYMENT ASPECT APPENDER ===== -->
    <appender name="PAYMENT_APPENDER"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>logs/payment-aspect.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/payment-aspect.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ===== DEFAULT APPLICATION APPENDER ===== -->
    <appender name="DEFAULT_APPENDER"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>logs/application.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ===== LOGGER FOR PAYMENT ASPECT ===== -->
    <logger name="com.reservation.aspect.PaymentAspect"
            level="INFO"
            additivity="false">
        <appender-ref ref="PAYMENT_APPENDER"/>
    </logger>

    <!-- ===== ROOT LOGGER (everything else) ===== -->
    <root level="INFO">
        <appender-ref ref="DEFAULT_APPENDER"/>
    </root>

</configuration>